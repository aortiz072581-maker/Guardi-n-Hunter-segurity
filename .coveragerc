[run]
source = guardian_hunter
branch = True
omit =
    */tests/*
    */test_*
    guardian_hunter/tests/*
    audit_full/*
    audit_artifacts/*
    .guardian/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass  # audit
    # fail-closed justified

[html]
directory = audit_full/htmlcov
